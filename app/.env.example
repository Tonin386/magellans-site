# =============================================================================
#  Configuration du site magellans.fr — copier ce fichier en app/.env
#  Les variables existantes de l'ancien site restent valables.
# =============================================================================

# --- Général -----------------------------------------------------------------
DEBUG=0                                   # 1 en développement uniquement
SECRET_KEY=                               # obligatoire en production (longue chaîne aléatoire)
SITE_URL=https://magellans.fr             # utilisé dans les liens des e-mails
ALLOWED_HOSTS=magellans.fr,www.magellans.fr,django
CSRF_TRUSTED_ORIGINS=https://magellans.fr,https://www.magellans.fr
NGINX_CONF_FILE=conf_ssl.d                # conf.d en développement (HTTP)
SSL_LETSENCRYPT=/etc/letsencrypt/         # certificats (production)

# --- Base de données (PostgreSQL) -------------------------------------------
DB_DJANGO_NAME=magellans-dj
DB_USER=
DB_PASSWORD=
DB_HOST=postgres-django                   # vide = SQLite local (développement sans Docker)
DB_PORT=5432

# --- E-mails ------------------------------------------------------------------
EMAIL_HOST=                               # vide = e-mails affichés dans la console (développement)
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_RECEIVER=contact@magellans.fr       # adresse d'expédition par défaut
# DEFAULT_FROM_EMAIL="Magellans <contact@magellans.fr>"

# --- HelloAsso (Mon compte › Intégrations et API) ----------------------------
HELLOASSO_CLIENTID=
HELLOASSO_CLIENTSECRET=
HELLOASSO_ORGANIZATION_SLUG=magellans
# Secret ajouté à l'URL de notification : https://magellans.fr/api/helloasso/<secret>/
# (générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))")
HELLOASSO_WEBHOOK_SECRET=

# --- Avancé (facultatif) -------------------------------------------------------
# GUNICORN_WORKERS=3
# LOG_LEVEL=INFO
# VITE_DEV_MODE=1                         # développement : assets servis par « npm run dev »
