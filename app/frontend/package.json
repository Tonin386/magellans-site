{
  "name": "magellans-frontend",
  "private": true,
  "type": "module",
  "description": "Interface du site magellans.fr (Vite + Tailwind CSS + HTMX + Alpine.js)",
  "scripts": {
    "dev": "node scripts/build-icons.mjs && vite",
    "build": "node scripts/build-icons.mjs && vite build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.17.4",
    "@alpinejs/csp": "3.17.4",
    "@alpinejs/focus": "3.17.4",
    "@alpinejs/intersect": "3.17.4",
    "@alpinejs/sort": "3.17.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "htmx.org": "2.0.11",
    "signature_pad": "5.1.4",
    "tom-select": "2.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "lucide-static": "1.52.0",
    "simple-icons": "16.34.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
