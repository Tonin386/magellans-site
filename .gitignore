# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Secrets & configuration locale (ne JAMAIS versionner) ---
*.env
.env.*
!.env.example
credentials
*.ini

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
app/staticfiles/
# Fichiers envoyés par les utilisateurs (publics et privés)
app/media/
app/private/
# Ancien emplacement des médias (avant la refonte 2026)
app/assets/media/
# Sauvegardes et journaux produits par run.sh
backups/
logs/

# --- Frontend (Vite) ---
node_modules/
app/frontend/dist/
app/frontend/.vite/

# --- Docker / serveur ---
postgres_data/
redis_data/
volumes/
build/

# --- Certificats : jetons temporaires de certbot ---
nginx/acme/*
!nginx/acme/.gitkeep

# --- Outils de sécurité du serveur ---
security/lists
ips.json
pids.txt

# --- Éditeurs ---
.idea/
.vscode/
*.swp
.DS_Store
